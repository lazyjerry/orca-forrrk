{
  "manifestVersion": 2,
  "id": "forrrk",
  "name": "forrrk",
  "version": "0.1.0",
  "description": "在 Orca 右側邊欄檢視 workspace 所在儲存庫的唯讀 git 資訊與忽略變更設定，並一鍵用 Fork 開啟。",
  "author": { "name": "workjerry" },
  "repository": "https://github.com/lazyjerry/orca-forrrk",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    { "kind": "terminal:send" }
  ],
  "contributes": {
    "panels": [
      {
        "id": "forrrk",
        "title": "forrrk",
        "icon": "layers",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      { "id": "forrrk.openInFork", "title": "forrrk: Open Current Repository in Fork", "when": "workspace" },
      { "id": "forrrk.openFolder", "title": "forrrk: Open Repository Folder", "when": "workspace" },
      { "id": "forrrk.autoPush", "title": "forrrk: Run git-auto-push -a", "when": "workspace" }
    ]
  }
}
